# ~/.tmux.theme.conf - written by mysetup (--do theme). Regenerated on change.
# Sourced from ~/.tmux.conf BEFORE the TPM init line, because the plugin has to
# be declared before TPM runs.
# Flavour: {{THEME_FLAVOUR}}
set -g @plugin 'catppuccin/tmux#{{CATPPUCCIN_TMUX_TAG}}'
set -g @catppuccin_flavor '{{THEME_FLAVOUR}}'
