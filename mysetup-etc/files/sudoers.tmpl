# /etc/sudoers.d/{{USER}}
# Generated by mysetup for {{USER}} on {{FQDN}} at {{DATETIME}}.
#
# Install as root:
#   install -o root -g root -m 0440 <this file> /etc/sudoers.d/{{USER}}
#   visudo -cf /etc/sudoers.d/{{USER}}
#
# NOTE the ':ALL' after NOPASSWD - 'NOPASSWD' alone is a syntax error.
{{USER}} ALL=(ALL) NOPASSWD:ALL

# --- Least-privilege alternative -----------------------------------------
# Comment the line above and uncomment these to allow only what the account
# actually needs (safer for service and agent accounts):
#
# Cmnd_Alias PKG_{{USER}} = /usr/bin/apt-get, /usr/bin/apt, /usr/bin/dpkg
# Cmnd_Alias SVC_{{USER}} = /usr/bin/systemctl
# {{USER}} ALL=(ALL) NOPASSWD: PKG_{{USER}}, SVC_{{USER}}
