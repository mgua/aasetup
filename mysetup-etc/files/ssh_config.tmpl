# ~/.ssh/config for {{USER}} on {{HOSTNAME}} - generated by mysetup {{DATE}}.
# Site hosts belong in mysetup-etc/files/ssh_config.tmpl, not here: this file
# is regenerated (with a backup) by 'mysetup --do sshconfig'.

Host *
    # Keep long sessions alive through NAT / firewall idle timeouts.
    ServerAliveInterval 60
    ServerAliveCountMax 5
    # Never hand this account's agent to a remote host.
    ForwardAgent no
    HashKnownHosts no
    AddKeysToAgent yes

# --- the git server ---------------------------------------------------------
Host {{GIT_HOST_ALIAS}} {{GIT_HOST}}
    HostName {{GIT_HOST}}
    User {{GIT_USER}}
    Port {{GIT_PORT}}
    IdentityFile {{SSH_KEY_PATH}}
    # Use ONLY the key above, even if an agent offers others.
    IdentitiesOnly yes

# --- public forges (same identity, ask your admin before adding keys) -------
Host github.com
    HostName github.com
    User git
    IdentityFile {{SSH_KEY_PATH}}
    IdentitiesOnly yes

