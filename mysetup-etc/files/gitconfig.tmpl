# ~/.gitconfig for {{USER}} - generated by mysetup on {{DATE}}.
# Site defaults live in mysetup-etc/files/gitconfig.tmpl; edit there, re-run
# 'mysetup --do gitconfig' and this file is rewritten (the old one is backed up).
[user]
	name = {{GIT_NAME}}
	email = {{GIT_EMAIL}}

[core]
	editor = nvim
	# Pin the identity used for git-over-ssh, so a personal key in the agent
	# cannot silently be used for this account's pushes.
	sshCommand = ssh -i {{SSH_KEY_PATH}}

[init]
	defaultBranch = main

[pull]
	ff = only

[push]
	default = simple
	autoSetupRemote = true

[merge]
	tool = nvimdiff
	conflictStyle = zdiff3

[mergetool "nvimdiff"]
	layout = (LOCAL,BASE,REMOTE)/MERGED

[diff]
	algorithm = histogram

[rerere]
	enabled = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[credential "https://huggingface.co"]
	provider = generic

[http]
	postBuffer = 2048M

[alias]
	st = status -sb
	lg = log --oneline --graph --decorate --all
	last = log -1 --stat
	unstage = restore --staged
