# Real account roster — keep real names / emails / keys out of git.
# Copy template-users.json -> users.json and edit locally.
users.json

# Python
__pycache__/
*.pyc
*.pyo

# A site's own mysetup config (real hosts, host keys, internal package lists).
# Copy mysetup-etc -> mysetup-etc.local and edit; mysetup prefers the .local one.
mysetup-etc.local/

# vf-harden: a site's real profile values (addresses, account names).
# Copy a profile from vf-harden/profiles/ and keep only the differences.
vf-harden/profiles.local/
